# Database configuration for CsecurityMES
# Uncomment and fill one of the following options.

# Option 1: full SQLAlchemy database URL
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gestione_accessi

# Option 2: individual MySQL variables
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=gestione_accessi
